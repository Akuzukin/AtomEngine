{
  "folders": [
    { "name": "Atom Scripts", "path": "." }
  ],
  "settings": {
    "dotnet.defaultSolution": "AtomScripts.sln",
    "dotnet.server.useOmnisharp": false,
    "dotnet.preferCSharpExtension": false,
    "files.exclude": { "**/bin": true, "**/obj": true },
    "search.exclude": { "**/bin": true, "**/obj": true }
  },
  "extensions": {
    "recommendations": ["ms-dotnettools.csharp", "ms-dotnettools.csdevkit"]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build scripts (Debug)",
        "type": "process",
        "command": "dotnet",
        "args": ["build", "GameScripts/GameScripts.csproj", "-c", "Debug", "-m:1", "-p:RestoreDisableParallel=true", "--ignore-failed-sources", "--nologo"],
        "options": { "cwd": "${workspaceFolder}" },
        "group": { "kind": "build", "isDefault": true },
        "problemMatcher": "$msCompile"
      },
      {
        "label": "Build scripts (Release)",
        "type": "process",
        "command": "dotnet",
        "args": ["build", "GameScripts/GameScripts.csproj", "-c", "Release", "-m:1", "-p:RestoreDisableParallel=true", "--ignore-failed-sources", "--nologo"],
        "options": { "cwd": "${workspaceFolder}" },
        "group": "build",
        "problemMatcher": "$msCompile"
      }
    ]
  }
}
